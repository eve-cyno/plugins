{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eve-cyno.dev/schemas/plugin-manifest.v1.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "version", "engines", "main"],
    "properties": {
        "id": { "type": "string", "maxLength": 100, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$" },
        "name": { "type": "string", "maxLength": 400 },
        "author": { "type": "string", "maxLength": 400 },
        "version": { "type": "string", "maxLength": 64 },
        "engines": {
            "type": "object", "additionalProperties": false, "required": ["eve-cyno-api"],
            "properties": { "eve-cyno-api": { "type": "string", "maxLength": 64 } }
        },
        "esiCompatibilityDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "main": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "background": { "type": "boolean" },
        "suspendUnderPressure": { "type": "boolean" },
        "wasm": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "type": "string", "pattern": "^[a-z]{1,24}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 800 },
        "activationEvents": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 100 } },
        "permissions": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "characters": { "enum": ["none", "selected", "all"] },
                "esi": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 100, "pattern": "^esi[-.][A-Za-z0-9_.:-]+$" } },
                "logs": { "type": "array", "maxItems": 2, "items": { "enum": ["gamelogs", "chatlogs"] } },
                "clipboard": { "type": "array", "maxItems": 1, "items": { "enum": ["read"] } },
                "network": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 255 } },
                "overlays": { "type": "boolean" },
                "hotkeys": { "type": "boolean" },
                "windowThumbnails": { "type": "boolean" },
                "windows": { "type": "boolean" },
                "notifications": { "type": "boolean" },
                "account": { "type": "boolean" },
                "ai": { "type": "boolean" },
                "files": { "type": "boolean" },
                "fit": { "type": "boolean" },
                "gameEvents": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["combat", "ewar", "mining", "notice"] } },
                "data": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["sde.universe", "sde.types", "market.hubs"] } },
                "storage": {
                    "type": "object", "additionalProperties": false,
                    "properties": { "quotaMB": { "type": "integer", "minimum": 1, "maximum": 20 } }
                },
                "database": {
                    "type": "object", "additionalProperties": false, "required": ["quotaMB"],
                    "properties": { "quotaMB": { "type": "integer", "minimum": 1, "maximum": 2048 } }
                },
                "services": {
                    "type": "object", "maxProperties": 32,
                    "propertyNames": { "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
                    "additionalProperties": { "type": "string", "pattern": "^\\^(0|[1-9][0-9]*)$" }
                },
                "optional": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                        "esi": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 100, "pattern": "^esi[-.][A-Za-z0-9_.:-]+$" } },
                        "network": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 255 } },
                        "clipboard": { "type": "array", "maxItems": 1, "items": { "enum": ["read"] } },
                        "notifications": { "type": "boolean" }
                    }
                }
            }
        },
        "contributes": {
            "type": "object", "additionalProperties": false,
            "properties": {
                "commands": {
                    "type": "array", "maxItems": 256,
                    "items": {
                        "type": "object", "additionalProperties": false, "required": ["id", "title"],
                        "properties": {
                            "id": { "$ref": "#/$defs/itemId" },
                            "title": { "type": "string", "minLength": 1, "maxLength": 60 }
                        }
                    }
                },
                "statusItems": {
                    "type": "array", "maxItems": 64,
                    "items": {
                        "type": "object", "additionalProperties": false, "required": ["id"],
                        "properties": {
                            "id": { "$ref": "#/$defs/itemId" },
                            "title": { "type": "string", "minLength": 1, "maxLength": 60 }
                        }
                    }
                },
                "tile": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                        "action": {
                            "type": "object", "additionalProperties": false, "required": ["command", "label"],
                            "properties": {
                                "command": { "$ref": "#/$defs/itemId" },
                                "label": { "type": "string", "minLength": 1, "maxLength": 80 }
                            }
                        }
                    }
                },
                "settings": { "type": "object" },
                "services": {
                    "type": "array", "maxItems": 32,
                    "items": {
                        "type": "object", "additionalProperties": false, "required": ["id", "version", "methods"],
                        "properties": {
                            "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
                            "version": { "type": "string", "maxLength": 64 },
                            "methods": {
                                "type": "object", "minProperties": 1, "maxProperties": 64,
                                "propertyNames": { "maxLength": 64, "pattern": "^[a-z][A-Za-z0-9]*$" },
                                "additionalProperties": {
                                    "type": "object", "additionalProperties": false, "required": ["params", "result"],
                                    "properties": { "params": { "type": "object" }, "result": { "type": "object" } }
                                }
                            }
                        }
                    }
                },
                "views": { "$ref": "#/$defs/openItems" },
                "windows": { "$ref": "#/$defs/openItems" },
                "overlays": { "$ref": "#/$defs/overlayItems" },
                "themes": { "$ref": "#/$defs/openItems" }
            }
        }
    },
    "$defs": {
        "itemId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]{0,63}$" },
        "overlayItems": {
            "type": "array", "maxItems": 16,
            "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "entry"],
                "properties": { "id": { "$ref": "#/$defs/itemId" }, "entry": { "type": "string", "maxLength": 256 } }
            }
        },
        "openItems": {
            "type": "array", "maxItems": 64,
            "items": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/itemId" } } }
        }
    }
}
